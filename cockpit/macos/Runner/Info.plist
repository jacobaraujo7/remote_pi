			<string>work.jacobmoura.cockpit.layout</string>
			<key>UTTypeDescription</key>
			<string>Cockpit Pane Layout</string>
			<key>UTTypeConformsTo</key>
			<array><string>public.yaml</string><string>public.plain-text</string></array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array><string>ckp</string></array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>work.jacobmoura.cockpit.dbquery</string>
			<key>UTTypeDescription</key>
			<string>Cockpit Database Query</string>
			<key>UTTypeConformsTo</key>

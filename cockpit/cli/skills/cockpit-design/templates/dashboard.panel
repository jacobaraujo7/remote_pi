---
title: Dashboard
reload: true
cwd: .
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Dashboard</title>
  <link rel="stylesheet" href="/__cockpit__/cockpit.css">
  <script src="/__cockpit__/petite-vue.js"></script>
  <script src="/__cockpit__/chart.js"></script>
</head>
<body>
  <div class="page" v-scope="App()" @vue:mounted="load" v-cloak>
    <!-- 1. toolbar: title · status · actions -->
    <div class="toolbar">
      <h1>Repository</h1>
      <span class="status">{{ status }}</span>
      <button @click="load" :disabled="loading">Refresh</button>
    </div>

    <!-- 2. numbers as stats -->
    <div class="kpis">
      <div class="card stat"><span class="value">{{ changed.length }}</span><span class="label">changed files</span></div>
      <div class="card stat"><span class="value">{{ commits.length }}</span><span class="label">recent commits</span></div>
      <div class="card stat"><span class="value">{{ branch || '—' }}</span><span class="label">branch</span></div>
    </div>

    <!-- 3. body grid: chart + table -->
    <div class="grid-2">
      <div class="card">
        <h3>Changes by kind</h3>
        <canvas id="chart" height="180"></canvas>
      </div>
      <div class="card">
        <h3>Recent commits</h3>
        <div v-if="loading" class="col"><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div></div>
        <p v-else-if="!commits.length" class="empty">No commits yet.</p>
        <table v-else>
          <tr v-for="c in commits" :key="c.sha"><td><code>{{ c.sha }}</code></td><td class="truncate">{{ c.msg }}</td></tr>
        </table>
      </div>
    </div>

    <!-- 4. errors at the bottom, never inline -->
    <pre v-if="error" class="error">{{ error }}</pre>
  </div>

  <script>
    function App() {
      let chart = null;
      return {
        loading: false, status: '', error: '', branch: '', changed: [], commits: [],

        async load() {
          if (!this._themed) { this._themed = true; cockpit.on('theme', () => this.draw()); }
          this.loading = true; this.status = 'loading…'; this.error = '';
          // Every call checks r.ok and surfaces r.error.
          const st = await cockpit('exec git status --porcelain');
          if (!st.ok) { this.fail(st.error); return; }
          this.changed = st.stdout.split('\n').filter(Boolean);
          const br = await cockpit('exec git branch --show-current');
          this.branch = br.ok ? br.stdout.trim() : '';
          const lg = await cockpit('exec git log --oneline -15');
          this.commits = lg.ok
            ? lg.stdout.split('\n').filter(Boolean).map(l => ({ sha: l.slice(0, 7), msg: l.slice(8) }))
            : [];
          this.loading = false;
          this.status = 'updated ' + new Date().toLocaleTimeString();
          this.draw();
        },

        fail(message) { this.loading = false; this.status = ''; this.error = message; },

        // Chart colors come from the theme; redraw when it changes.
        async draw() {
          await new Promise(requestAnimationFrame);
          const el = document.getElementById('chart');
          if (!el) return;
          const kinds = {};
          for (const l of this.changed) { const k = l.slice(0, 2).trim() || '?'; kinds[k] = (kinds[k] || 0) + 1; }
          if (chart) chart.destroy();
          chart = new Chart(el, {
            type: 'bar',
            data: { labels: Object.keys(kinds), datasets: [{ data: Object.values(kinds), backgroundColor: cockpit.theme['--ckp-accent'] }] },
            options: { plugins: { legend: { display: false } },
              scales: { x: { ticks: { color: cockpit.theme['--ckp-text-muted'] }, grid: { display: false } },
                        y: { ticks: { color: cockpit.theme['--ckp-text-muted'], precision: 0 }, grid: { color: cockpit.theme['--ckp-border'] } } } },
          });
        },
      };
    }
    PetiteVue.createApp().mount();
  </script>
</body>
</html>

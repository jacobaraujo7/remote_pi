---
title: GitHub Actions
reload: true
cwd: .
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>GitHub Actions</title>
  <link rel="stylesheet" href="/__cockpit__/cockpit.css">
  <script src="/__cockpit__/petite-vue.js"></script>
  <style>
    .run { display: grid; grid-template-columns: 22px 1fr auto; gap: 12px; align-items: center; cursor: pointer; }
    .run:hover, .job:hover { border-color: var(--ckp-accent); }
    .job { cursor: pointer; }
    .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; background: var(--ckp-text-muted); }
    .dot.success { background: var(--ckp-ok); }
    .dot.failure, .dot.cancelled, .dot.timed_out { background: var(--ckp-error); }
    .dot.in_progress { background: var(--ckp-warn); animation: pulse 1s infinite alternate; }
    .dot.queued, .dot.waiting, .dot.pending { background: var(--ckp-warn); opacity: .5; }
    .dot.skipped { background: var(--ckp-border-strong); }
    @keyframes pulse { from { opacity: .35 } to { opacity: 1 } }
    .steps { margin: 8px 0 0 22px; }
    .step { display: flex; gap: 8px; align-items: center; padding: 2px 0; }
    .tick { font-size: 11px; color: var(--ckp-text-muted); font-variant-numeric: tabular-nums; }
  </style>
</head>
<body>
  <div class="page" v-scope="App()" @vue:mounted="init" v-cloak>

    <!-- ===== Lista: últimos 5 runs ===== -->
    <div v-if="!run">
      <div class="toolbar">
        <h1>GitHub Actions</h1>
        <span class="status">{{ status }}</span>
        <span class="badge warn" v-if="timer">live · {{ countdown }}s</span>
        <button @click="loadList" :disabled="loading">Refresh</button>
      </div>

      <div class="col">
        <div class="card run" v-for="r in runs" :key="r.databaseId" @click="cockpit.route.go('/run/' + r.databaseId)">
          <span class="dot" :class="r.status === 'completed' ? r.conclusion : r.status"></span>
          <div class="truncate">
            <div class="truncate"><b>{{ r.displayTitle }}</b></div>
            <div class="muted truncate">
              {{ r.workflowName }} · <code>{{ r.headBranch }}</code> · {{ r.event }} · {{ ago(r.createdAt) }}
            </div>
          </div>
          <span class="badge" :class="badge(r)">{{ label(r) }}</span>
        </div>
      </div>
      <p v-if="!loading && !runs.length && !error" class="muted">No workflow runs.</p>
    </div>

    <!-- ===== Detalhe: jobs de um run ===== -->
    <div v-else>
      <div class="row between mb-16">
        <button @click="cockpit.route.go('/')">← Back</button>
        <span class="muted grow truncate">{{ run.workflowName }} · <code>{{ run.headBranch }}</code> · #{{ run.number }}</span>
        <span class="badge warn" v-if="timer">live · {{ countdown }}s</span>
        <span class="badge" :class="badge(run)">{{ label(run) }}</span>
        <a class="btn" :href="run.url">Open on GitHub</a>
      </div>
      <h1>{{ run.displayTitle }}</h1>
      <div class="row gap-16 muted mb-16">
        <span>{{ run.jobs.length }} jobs</span>
        <span class="ok">{{ count('success') }} ok</span>
        <span class="error" v-if="count('failure')">{{ count('failure') }} failed</span>
        <span class="warn" v-if="active(run.jobs)">{{ active(run.jobs) }} running</span>
        <span>{{ duration(run.createdAt, run.updatedAt, run.status) }}</span>
      </div>

      <div class="col">
        <div class="card job" v-for="j in run.jobs" :key="j.databaseId" @click="toggle(j.databaseId)">
          <div class="row">
            <span class="dot" :class="j.status === 'completed' ? j.conclusion : j.status"></span>
            <b class="grow truncate">{{ j.name }}</b>
            <span class="tick">{{ duration(j.startedAt, j.completedAt, j.status) }}</span>
            <span class="badge" :class="badge(j)">{{ label(j) }}</span>
          </div>
          <div class="steps" v-if="open[j.databaseId] || j.status === 'in_progress'">
            <div class="step" v-for="s in j.steps" :key="s.number">
              <span class="dot" :class="s.status === 'completed' ? s.conclusion : s.status"></span>
              <span class="grow truncate" :class="{ muted: s.conclusion === 'skipped' }">{{ s.name }}</span>
              <span class="tick">{{ duration(s.startedAt, s.completedAt, s.status) }}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <pre v-if="error" class="error mt-16">{{ error }}</pre>
  </div>

  <script>
    const LIST_FIELDS = 'databaseId,number,displayTitle,workflowName,status,conclusion,headBranch,event,createdAt,updatedAt,url';
    const RUN_FIELDS = LIST_FIELDS + ',jobs';
    const POLL_SECONDS = 10;

    function App() {
      return {
        runs: [], run: null, open: {}, loading: false, status: '', error: '',
        timer: null, countdown: POLL_SECONDS,

        async init() {
          cockpit.on('route', () => this.route());
          await this.route();
        },

        async route() {
          const m = cockpit.route.match('/run/:id');
          if (m) await this.loadRun(m.id); else { this.run = null; await this.loadList(); }
        },

        async loadList() {
          this.loading = true; this.status = 'loading...'; this.error = '';
          const r = await cockpit('exec gh run list --limit 5 --json ' + LIST_FIELDS);
          this.loading = false;
          if (!r.ok) { this.status = ''; this.error = r.error; this.stop(); return; }
          this.runs = r.json || [];
          this.status = 'updated ' + new Date().toLocaleTimeString();
          this.schedule(this.runs.some(x => x.status !== 'completed'));
        },

        async loadRun(id) {
          this.error = '';
          const r = await cockpit('exec gh run view ' + id + ' --json ' + RUN_FIELDS);
          if (!r.ok) { this.error = r.error; this.stop(); return; }
          this.run = r.json;
          this.schedule(this.run.status !== 'completed');
        },

        // Polling só enquanto há algo rodando; o gh não tem stream que caiba
        // aqui (`gh run watch` bloqueia o processo), então é refetch a cada 10s.
        schedule(active) {
          this.stop();
          if (!active) return;
          this.countdown = POLL_SECONDS;
          this.timer = setInterval(() => {
            this.countdown--;
            if (this.countdown <= 0) { this.countdown = POLL_SECONDS; this.route(); }
          }, 1000);
        },
        stop() { if (this.timer) { clearInterval(this.timer); this.timer = null; } },

        toggle(id) { this.open[id] = !this.open[id]; },
        count(c) { return this.run.jobs.filter(j => j.conclusion === c).length; },
        active(jobs) { return jobs.filter(j => j.status !== 'completed').length; },

        label(x) { return x.status === 'completed' ? (x.conclusion || 'done') : x.status.replace('_', ' '); },
        badge(x) {
          if (x.status !== 'completed') return 'warn';
          return { success: 'ok', failure: 'error', cancelled: 'error', timed_out: 'error' }[x.conclusion] || '';
        },
        ago(iso) {
          const s = (Date.now() - new Date(iso)) / 1000;
          if (s < 60) return 'just now';
          if (s < 3600) return Math.floor(s / 60) + 'm ago';
          if (s < 86400) return Math.floor(s / 3600) + 'h ago';
          return Math.floor(s / 86400) + 'd ago';
        },
        duration(start, end, status) {
          if (!start) return '';
          const stop = (status === 'completed' && end) ? new Date(end) : Date.now();
          const s = Math.max(0, Math.round((stop - new Date(start)) / 1000));
          return s < 60 ? s + 's' : Math.floor(s / 60) + 'm ' + (s % 60) + 's';
        },
      };
    }
    PetiteVue.createApp().mount();
  </script>
</body>
</html>

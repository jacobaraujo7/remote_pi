[Unit]
Description=Remote Pi daemon supervisor (plan/26)
Documentation=https://remote-pi.jacobmoura.work
After=default.target

[Service]
Type=simple
ExecStart={NODE} {SUPERVISOR}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
# Inherit the user's shell PATH so `pi --mode rpc` resolves to the same
# binary it would in an interactive shell (npm-global / Homebrew / etc.).
Environment="PATH={PATH}"
Environment="HOME={HOME}"
# Pin the agent backend (pi or omp) so the state namespace the installer
# detected survives the reboot (issue #170).
Environment="REMOTE_PI_AGENT_BIN={AGENT_BIN}"
Environment="REMOTE_PI_STATE_PREFIX={STATE_PREFIX}"

[Install]
WantedBy=default.target

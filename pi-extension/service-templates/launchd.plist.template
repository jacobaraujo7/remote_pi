<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Remote Pi daemon supervisor (plan/26). Generated by `remote-pi install`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.remotepi.supervisord</string>

  <key>ProgramArguments</key>
  <array>
    <string>{NODE}</string>
    <string>{SUPERVISOR}</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{LOG}</string>
  <key>StandardErrorPath</key>
  <string>{LOG}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Inherit the user's shell PATH so `pi --mode rpc` resolves to the
         same binary it would in Terminal.app (Homebrew / npm-global / etc.). -->
    <key>PATH</key>
    <string>{PATH}</string>
    <key>HOME</key>
    <string>{HOME}</string>
    <!-- Pin the agent backend (pi or omp) so the state namespace the
         installer detected survives the reboot (issue #170). -->
    <key>REMOTE_PI_AGENT_BIN</key>
    <string>{AGENT_BIN}</string>
    <key>REMOTE_PI_STATE_PREFIX</key>
    <string>{STATE_PREFIX}</string>
  </dict>
</dict>
</plist>
